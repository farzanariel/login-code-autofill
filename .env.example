# Google Cloud OAuth client, type "Desktop app" (see README).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Written by `npm run auth`. One refresh token per mailbox.
GMAIL_REFRESH_TOKEN=

# Optional: search more than one inbox. Comma-separated env var names,
# each minted with `node helper/auth.js --env-key <NAME> --login-hint <address>`.
# LOGIN_CODE_MAILBOXES=GMAIL_REFRESH_TOKEN,GMAIL_WORK_REFRESH_TOKEN

# Optional: helper port. The extension expects 7791.
# LOGIN_CODE_PORT=7791
